# SAFEGRID Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a filled-in .env file.

# --------------------------------------------------
# REQUIRED: Gemini AI API Key
# Used by the Express backend for AI-powered features.
# Get yours at: https://aistudio.google.com/app/apikey
# --------------------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# --------------------------------------------------
# OPTIONAL: Application URL
# The public URL where this app is deployed.
# Used for self-referential QR code links in Connect Friend's Phone feature.
# Defaults to http://localhost:5173 in development.
# --------------------------------------------------
APP_URL="http://localhost:5173"

# --------------------------------------------------
# OPTIONAL: Server Port
# Port for the Express backend server.
# Defaults to 5173 (served via Vite dev proxy).
# --------------------------------------------------
PORT=5173

# --------------------------------------------------
# MAPS & ROUTING:
# SAFEGRID includes a full Live OpenStreetMap + OSRM Routing engine
# with CartoDB dark tiles and Nominatim geocoding.
# NO API KEY REQUIRED out-of-the-box!
# (Optional: If integrating custom Google Maps / Mapbox, add key here)
# --------------------------------------------------
# MAPS_API_KEY="YOUR_MAPS_KEY_HERE"
